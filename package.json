{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names app,figma --prefix-colors cyan,magenta --kill-others-on-fail \"npm:dev:app\" \"npm:dev:figma\"",
    "dev:app": "vite --host",
    "dev:figma": "tsx watch tools/figma-bridge/server.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:icon-types": "node scripts/gen-icon-types.mjs",
    "figma:check": "figma connect parse --exit-on-unreadable-files --skip-update-check",
    "figma:export": "tsx tools/figma-export/cli.ts",
    "figma:export:check": "tsx tools/figma-export/cli.ts --check",
    "figma:export:diagnostic": "tsx tools/figma-export/cli.ts --allow-blocked-requests",
    "figma:export:diagnostic:check": "tsx tools/figma-export/cli.ts --allow-blocked-requests --check",
    "plugin:build": "tsc -p figma-plugin/tsconfig.json && node figma-plugin/build.mjs",
    "plugin:check": "tsc -p figma-plugin/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@acko/accordion": "4.0.0",
    "@acko/alert": "4.0.0",
    "@acko/avatar": "4.0.0",
    "@acko/badge": "4.0.0",
    "@acko/breadcrumb": "4.0.0",
    "@acko/button": "4.0.0",
    "@acko/calendar": "4.0.0",
    "@acko/card": "4.0.0",
    "@acko/checkbox": "4.0.0",
    "@acko/chip": "4.0.0",
    "@acko/css": "4.0.0",
    "@acko/dialog": "4.0.0",
    "@acko/drawer": "4.0.0",
    "@acko/dropdown": "4.0.0",
    "@acko/field": "4.0.0",
    "@acko/form": "4.0.0",
    "@acko/icons": "4.0.0",
    "@acko/input-group": "4.0.0",
    "@acko/label": "4.0.0",
    "@acko/navigation-wizard": "4.0.0",
    "@acko/otp-input": "4.0.0",
    "@acko/pagination": "4.0.0",
    "@acko/progress": "4.0.0",
    "@acko/radio": "4.0.0",
    "@acko/scroll-area": "4.0.0",
    "@acko/separator": "4.0.0",
    "@acko/skeleton": "4.0.0",
    "@acko/slider": "4.0.0",
    "@acko/switch": "4.0.0",
    "@acko/table": "4.0.0",
    "@acko/tabs": "4.0.0",
    "@acko/text-input": "4.0.0",
    "@acko/textarea": "4.0.0",
    "@acko/toast": "4.0.0",
    "@acko/toggle": "4.0.0",
    "@acko/tokens": "4.0.0",
    "@acko/tooltip": "4.0.0",
    "@acko/typography": "4.0.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@figma/code-connect": "2.0.0",
    "@figma/plugin-typings": "1.136.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "22.18.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "1.55.0",
    "tailwindcss": "^4.0.0",
    "tsx": "4.20.5",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
